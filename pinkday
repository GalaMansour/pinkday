<title>Pink Ribbon Walk</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@500;700&family=Press+Start+2P&display=swap">
<style>
/* Layout: one 704x1254 pixel stage (the background's own size), scaled to fit the phone.
   Quiz card sits in the empty sky; the girl walks along the stone path at the bottom. */
:root {
  --ink: #3a1f2b;
  --pink: #e377ab;
  --pink-deep: #b8457a;
  --pink-soft: #f9dfe8;
  --paper: #fff8fb;
  --leaf: #3f7a3a;
  --leaf-soft: #dcf0d4;
  --oops: #a8392a;
  --oops-soft: #fbddd6;
  --sky-top: #a9cbf2;
  --sky-low: #c3d9f6;
  --display: 'Press Start 2P', ui-monospace, 'Courier New', monospace;
  --body: 'Pixelify Sans', 'Trebuchet MS', Verdana, sans-serif;
  color-scheme: light;
}
html, body { height: 100%; }
body {
  margin: 0;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: linear-gradient(var(--sky-top), var(--sky-low));
  color: var(--ink);
  font-family: var(--body);
  -webkit-tap-highlight-color: transparent;
  user-select: none;
  -webkit-user-select: none;
}
#box { position: relative; overflow: hidden; flex: none; box-shadow: 0 0 40px rgba(40, 50, 100, .25); }
#stage { position: absolute; left: 0; top: 0; width: 704px; height: 1254px; transform-origin: 0 0; }
#bg { position: absolute; inset: 0; width: 704px; height: 1254px; image-rendering: pixelated; display: block; }

/* quiz card */
.card {
  position: absolute;
  left: 38px; top: 136px; width: 628px;
  box-sizing: border-box;
  padding: 26px 30px 28px;
  background: var(--paper);
  box-shadow:
    -6px 0 0 0 var(--ink), 6px 0 0 0 var(--ink), 0 -6px 0 0 var(--ink), 0 6px 0 0 var(--ink),
    inset 0 0 0 4px var(--pink-soft),
    10px 16px 0 -2px rgba(58, 31, 43, .22);
  animation: pop .35s steps(5) both;
}
@keyframes pop { from { transform: translateY(14px); opacity: 0; } to { transform: none; opacity: 1; } }

.kicker { font-family: var(--display); font-size: 20px; letter-spacing: 1px; color: var(--pink-deep); }
.head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
.pips { display: flex; gap: 10px; }
.pip { width: 22px; height: 22px; background: #fff; box-shadow: 0 0 0 3px var(--ink); }
.pip.on { background: var(--pink); }
.pip.now { background: var(--pink-soft); }

h1, h2 { margin: 0; text-wrap: balance; }
h1 { font-family: var(--display); font-weight: 400; font-size: 40px; line-height: 1.35; color: var(--pink-deep); text-shadow: 4px 4px 0 var(--pink-soft); }
h2 { font-weight: 700; font-size: 35px; line-height: 1.2; min-height: 84px; }
.lead { font-size: 31px; line-height: 1.25; margin: 18px 0 24px; }

.opts { display: grid; gap: 12px; margin-top: 18px; min-height: 270px; align-content: start; }
.opt {
  appearance: none; border: 0; cursor: pointer; text-align: left;
  display: flex; align-items: center; gap: 16px;
  min-height: 58px; padding: 6px 16px 6px 8px;
  background: #fff; color: var(--ink);
  font: 700 30px/1.1 var(--body);
  box-shadow: -4px 0 0 0 var(--ink), 4px 0 0 0 var(--ink), 0 -4px 0 0 var(--ink), 0 4px 0 0 var(--ink);
  touch-action: manipulation;
}
.opt:hover { background: var(--pink-soft); }
.opt:focus-visible, .btn:focus-visible { outline: 4px dashed var(--pink-deep); outline-offset: 6px; }
.opt .k {
  flex: none; width: 44px; height: 44px; display: grid; place-items: center;
  background: var(--pink); color: #fff; font: 400 20px var(--display);
}
.opt.good { background: var(--leaf-soft); }
.opt.good .k { background: var(--leaf); }
.opt.bad { background: var(--oops-soft); color: var(--oops); animation: nope .4s steps(8); }
.opt.bad .k { background: var(--oops); }
.opt:disabled { cursor: default; }
@keyframes nope { 25% { transform: translateX(-8px); } 75% { transform: translateX(8px); } }

.fact { grid-row: 1; margin: 0; padding: 20px 22px; background: var(--pink-soft); box-shadow: -4px 0 0 0 var(--ink), 4px 0 0 0 var(--ink), 0 -4px 0 0 var(--ink), 0 4px 0 0 var(--ink); animation: pop .3s steps(4) both; }
.fact b { display: block; font: 400 18px var(--display); color: var(--pink-deep); margin-bottom: 12px; }
.fact span { font-size: 31px; line-height: 1.25; font-weight: 500; }

.msg { min-height: 36px; margin: 14px 0 0; font-size: 28px; font-weight: 700; color: var(--oops); }

.btn {
  appearance: none; border: 0; cursor: pointer;
  background: var(--pink); color: #fff;
  font: 400 24px/1 var(--display);
  padding: 22px 28px;
  box-shadow: -5px 0 0 0 var(--ink), 5px 0 0 0 var(--ink), 0 -5px 0 0 var(--ink), 0 5px 0 0 var(--ink), inset 0 -6px 0 0 var(--pink-deep);
  touch-action: manipulation;
}
.btn:active { transform: translateY(3px); }

/* win card */
.win-row { display: flex; align-items: center; gap: 20px; margin-bottom: 20px; }
.win-row img { width: 112px; height: auto; flex: none; }
.quote { margin: 0 0 24px; padding: 20px 22px; background: var(--pink-soft); font-size: 33px; line-height: 1.25; font-weight: 500; box-shadow: -4px 0 0 0 var(--ink), 4px 0 0 0 var(--ink), 0 -4px 0 0 var(--ink), 0 4px 0 0 var(--ink); }
.quote small { display: block; font: 400 18px var(--display); color: var(--pink-deep); margin-bottom: 12px; }

/* hero */
#hero { position: absolute; left: 0; top: 1004px; width: 150px; height: 192px; margin-left: -75px; will-change: transform; }
#shadow { position: absolute; left: 50%; bottom: -8px; width: 110px; height: 20px; margin-left: -55px; border-radius: 50%; background: rgba(20, 20, 60, .35); }
#lift { position: absolute; inset: 0; display: flex; justify-content: center; align-items: flex-end; transform-origin: 50% 100%; }
#sprite { height: 192px; width: auto; display: block; }
#sprite.idle { animation: breathe 2.4s ease-in-out infinite; transform-origin: 50% 100%; }
@keyframes breathe { 50% { transform: scaleY(1.025); } }

.spark { position: absolute; width: 12px; height: 12px; pointer-events: none; z-index: 5; }
#confetti { position: absolute; inset: 0; pointer-events: none; z-index: 6; }
.conf { position: absolute; top: 0; }

@media (prefers-reduced-motion: reduce) {
  #sprite.idle, .card, .fact { animation: none; }
}
</style>

<div id="box">
  <div id="stage">
    <img id="bg" alt="" src="{{pinkbg.png}}">

    <section class="card" id="start">
      <div class="head"><span class="kicker">OCTOBER · PINK MONTH</span></div>
      <h1>PINK RIBBON<br>WALK</h1>
      <p class="lead">Answer 5 quick questions about breast cancer awareness. Every right answer takes her one hop closer to the bench.</p>
      <button class="btn" id="go" type="button">START</button>
    </section>

    <section class="card" id="qa" hidden>
      <div class="head">
        <span class="kicker" id="qnum">QUESTION 1 / 5</span>
        <span class="pips" id="pips" aria-hidden="true"></span>
      </div>
      <h2 id="qtext"></h2>
      <div class="opts" id="opts"></div>
      <p class="msg" id="msg" aria-live="polite"></p>
    </section>

    <section class="card" id="win" hidden style="top:170px">
      <div class="win-row">
        <img alt="" src="{{HAPPY}}">
        <div>
          <h1>YOU WON!</h1>
          <div class="kicker" style="margin-top:12px">5 OF 5 RIGHT</div>
        </div>
      </div>
      <p class="quote"><small>REMEMBER</small>Pink is more than a color. It is a promise that no one faces this alone.</p>
      <button class="btn" id="again" type="button">PLAY AGAIN</button>
    </section>

    <div id="hero">
      <div id="shadow"></div>
      <div id="lift"><img id="sprite" class="idle" alt="Girl in pink" src="{{front.png
      }}"></div>
    </div>
    <div id="confetti"></div>
  </div>
</div>

<script>
(function () {
  var SPR = { front: "{{front.png}}", walk: "{{walkl.png}}", walkL: "{{walkl.png}}" };
  var QUESTIONS = [
    { q: "Which color is the ribbon for breast cancer awareness?", a: ["Green", "Pink", "Blue", "Yellow"], c: 1,
      f: "The pink ribbon is the worldwide symbol of breast cancer awareness." },
    { q: "Which month is Breast Cancer Awareness Month?", a: ["October", "March", "July", "December"], c: 0,
      f: "Every October, people around the world wear pink to show their support." },
    { q: "What is the breast X-ray test used for screening called?", a: ["Vaccine", "Bandage", "Mammogram", "Thermometer"], c: 2,
      f: "A mammogram can spot changes in the breast before they can be felt." },
    { q: "Finding breast cancer early can make it easier to treat.", a: ["True", "False"], c: 0,
      f: "Regular check-ups and screening help find it early, when treatment works best." },
    { q: "You notice a new lump in your breast. What should you do?", a: ["Ignore it", "Wait a whole year", "Hide it and say nothing", "Tell a doctor soon"], c: 3,
      f: "Most lumps are not cancer, but only a doctor can tell. Checking is always worth it." }
  ];
  var STOPS = [70, 177, 284, 391, 498, 605];
  var FOOT = 1196;

  var $ = function (id) { return document.getElementById(id); };
  var box = $("box"), stage = $("stage"), hero = $("hero"), lift = $("lift"), sprite = $("sprite"), shadow = $("shadow");
  var elStart = $("start"), elQa = $("qa"), elWin = $("win");
  var qnum = $("qnum"), qtext = $("qtext"), opts = $("opts"), msg = $("msg"), pips = $("pips");
  var idx = 0, curX = STOPS[0], phase = "start";

  // preload sprites
  Object.keys(SPR).forEach(function (k) { var i = new Image(); i.src = SPR[k]; });

  function fit() {
    var w = document.body.clientWidth || window.innerWidth;
    var h = document.body.clientHeight || window.innerHeight;
    var s = Math.min(w / 704, h / 1254);
    box.style.width = Math.floor(704 * s) + "px";
    box.style.height = Math.floor(1254 * s) + "px";
    stage.style.transform = "scale(" + s + ")";
  }
  window.addEventListener("resize", fit);
  fit();

  var wait = function (ms) { return new Promise(function (r) { setTimeout(r, ms); }); };
  function tween(ms, fn) {
    return new Promise(function (res) {
      var t0 = performance.now();
      (function f(t) {
        var p = Math.min(1, Math.max(0, (t - t0) / ms));
        fn(p);
        if (p < 1) requestAnimationFrame(f); else res();
      })(t0);
    });
  }

  function place(x) { hero.style.transform = "translateX(" + x + "px)"; }
  function pose(y, rot, sx, sy) {
    lift.style.transform = "translateY(" + (-y) + "px) rotate(" + rot + "deg) scale(" + sx + "," + sy + ")";
    var k = Math.max(.45, 1 - y / 320);
    shadow.style.transform = "scale(" + k + ")";
    shadow.style.opacity = String(k);
  }
  function setSprite(k) { sprite.src = SPR[k]; }
  function idle(on) { sprite.classList.toggle("idle", on); }
  place(curX); pose(0, 0, 1, 1);

  var COLORS = ["#e377ab", "#f9b4cf", "#ffffff", "#b8457a", "#ffd6e6"];
  function burst(x, y, n) {
    for (var i = 0; i < n; i++) {
      var d = document.createElement("i");
      d.className = "spark";
      d.style.left = x + "px"; d.style.top = y + "px";
      d.style.background = COLORS[i % COLORS.length];
      stage.appendChild(d);
      var a = Math.PI * (1 + (i + .5) / n);
      var r = 50 + Math.random() * 50;
      var anim = d.animate(
        [{ transform: "translate(0,0)", opacity: 1 }, { transform: "translate(" + Math.cos(a) * r + "px," + (Math.sin(a) * r - 10) + "px)", opacity: 0 }],
        { duration: 650, easing: "ease-out" }
      );
      anim.onfinish = (function (el) { return function () { el.remove(); }; })(d);
    }
  }

  async function walkTo(x2) {
    var x1 = curX;
    if (Math.abs(x2 - x1) < 1) return;
    setSprite(x2 > x1 ? "walk" : "walkL"); idle(false);
    var dur = Math.abs(x2 - x1) * 9 + 200;
    await tween(dur, function (p) {
      place(x1 + (x2 - x1) * p);
      var ph = p * Math.PI * Math.max(2, Math.round(Math.abs(x2 - x1) / 36)) * 2;
      pose(Math.abs(Math.sin(ph)) * 12, Math.sin(ph) * 3, 1, 1);
    });
    curX = x2; pose(0, 0, 1, 1); setSprite("front"); idle(true);
  }
  async function jump(h) {
    h = h || 130; idle(false); setSprite("front");
    await tween(110, function (p) { pose(0, 0, 1 + .07 * p, 1 - .1 * p); });
    await tween(760, function (p) {
      var s = Math.sin(Math.PI * p);
      pose(4 * h * p * (1 - p), 0, 1 - .04 * s, 1 + .07 * s);
    });
    burst(curX, FOOT - 4, 10);
    await tween(150, function (p) { pose(0, 0, 1 + .08 * (1 - p), 1 - .1 * (1 - p)); });
    pose(0, 0, 1, 1); idle(true);
  }
  async function shake() {
    await tween(420, function (p) { place(curX + Math.sin(p * Math.PI * 6) * 9 * (1 - p)); });
    place(curX);
  }

  function renderPips(now, done) {
    pips.innerHTML = "";
    for (var i = 0; i < QUESTIONS.length; i++) {
      var s = document.createElement("span");
      s.className = "pip" + (i < done ? " on" : (i === now ? " now" : ""));
      pips.appendChild(s);
    }
  }

  function showQuestion() {
    var q = QUESTIONS[idx];
    qnum.textContent = "QUESTION " + (idx + 1) + " / " + QUESTIONS.length;
    renderPips(idx, idx);
    qtext.textContent = q.q;
    msg.textContent = "";
    opts.innerHTML = "";
    q.a.forEach(function (text, i) {
      var b = document.createElement("button");
      b.type = "button"; b.className = "opt"; b.dataset.i = i;
      b.innerHTML = '<span class="k">' + "ABCD"[i] + "</span><span></span>";
      b.lastChild.textContent = text;
      b.addEventListener("click", function () { choose(i, b); });
      opts.appendChild(b);
    });
    phase = "ask";
  }

  async function choose(i, btn) {
    if (phase !== "ask") return;
    var q = QUESTIONS[idx];
    if (i !== q.c) {
      btn.classList.add("bad"); btn.disabled = true;
      msg.textContent = "Not quite. Try another answer!";
      phase = "busy"; await shake(); phase = "ask";
      return;
    }
    phase = "busy";
    btn.classList.add("good");
    Array.prototype.forEach.call(opts.children, function (b) { b.disabled = true; });
    msg.textContent = "";
    renderPips(idx, idx + 1);
    await wait(650);
    opts.innerHTML = '<p class="fact"><b>DID YOU KNOW?</b><span></span></p>';
    opts.querySelector("span").textContent = q.f;
    await walkTo(STOPS[idx + 1]);
    await jump(130);
    if (idx === QUESTIONS.length - 1) { await finish(); return; }
    await wait(900);
    idx++;
    showQuestion();
  }

  function confetti() {
    var layer = $("confetti");
    for (var i = 0; i < 44; i++) {
      var d = document.createElement("i");
      d.className = "conf";
      var sz = 10 + Math.round(Math.random() * 3) * 4;
      d.style.cssText = "left:" + Math.round(Math.random() * 690) + "px;width:" + sz + "px;height:" + sz + "px;background:" + COLORS[i % COLORS.length];
      layer.appendChild(d);
      var dx = (Math.random() - .5) * 120;
      var an = d.animate(
        [{ transform: "translate(0,-30px) rotate(0)", opacity: 1 }, { transform: "translate(" + dx + "px,1290px) rotate(" + (Math.random() * 720 - 360) + "deg)", opacity: 1 }],
        { duration: 2600 + Math.random() * 2200, delay: Math.random() * 900, easing: "ease-in", fill: "backwards" }
      );
      an.onfinish = (function (el) { return function () { el.remove(); }; })(d);
    }
  }

  async function finish() {
    confetti();
    await jump(170);
    await jump(170);
    elQa.hidden = true;
    elWin.hidden = false;
    phase = "won";
  }

  async function restart() {
    if (phase !== "won") return;
    phase = "busy";
    elWin.hidden = true;
    idx = 0;
    await walkTo(STOPS[0]);
    elQa.hidden = false;
    showQuestion();
  }

  $("go").addEventListener("click", function () {
    elStart.hidden = true; elQa.hidden = false; showQuestion();
  });
  $("again").addEventListener("click", restart);
  document.addEventListener("keydown", function (e) {
    if (phase !== "ask") return;
    var n = parseInt(e.key, 10);
    var b = opts.children[n - 1];
    if (n >= 1 && b && !b.disabled) b.click();
  });
})();
</script>
